\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Illustrates the approximated density flow solution $\rho (t,x)$ alongside controlled Euler--Maruyama particle trajectories for baseline parameters $\kappa =0.12$, $N_{t} =50$, and $h_{\max } =0.06$ ($N=1388$ nodes). The outer iterate is with damping factor $\theta =0.65$ converges in $n=22$ iterations and attained $L^{1}$ density residual of $\| \Delta \rho ^{22} \| _{L^{1}} =1.156\times 10^{-8}$ ($\| \Delta \rho ^{22} \| _{L^{\infty }} =3.515\times 10^{-6}$), a terminal Wasserstein-2 particle discrepancy of $W_{2} =5.365\times 10^{-2}$, and a total wall-clock execution time $155.47\text  { s}$. }}{1}{figure.caption.1}\protected@file@percent }
\newlabel{fig:density_particle_2d_illustrate}{{1}{1}{Illustrates the approximated density flow solution $\rho (t,x)$ alongside controlled Euler--Maruyama particle trajectories for baseline parameters $\kappa =0.12$, $N_{t} =50$, and $h_{\max } =0.06$ ($N=1388$ nodes). The outer iterate is with damping factor $\theta =0.65$ converges in $n=22$ iterations and attained $L^{1}$ density residual of $\| \Delta \rho ^{22} \| _{L^{1}} =1.156\times 10^{-8}$ ($\| \Delta \rho ^{22} \| _{L^{\infty }} =3.515\times 10^{-6}$), a terminal Wasserstein-2 particle discrepancy of $W_{2} =5.365\times 10^{-2}$, and a total wall-clock execution time $155.47\text { s}$}{figure.caption.1}{}}
\newlabel{fig:density_particle_2d_illustrate@cref}{{[figure][1][]1}{[1][1][]1}{}{}{}}
